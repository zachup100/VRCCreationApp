{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "VRCCreationApp",
	"version": "0.1.0",
	"identifier": "net.zachlabs.vrccreationapp.main",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build:vite",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "VRCCreationApp",
				"width": 1100,
				"height": 720,
				"minWidth": 1024,
				"minHeight": 520
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"nsis",
			"msi"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": false
			},
			"nsis": {
				"installMode": "currentUser",
				"displayLanguageSelector": false
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"category": "DeveloperTool",
		"shortDescription": "Manage VRChat projects and VPM packages",
		"longDescription": "An open-source manager for VRChat Unity projects and VPM packages, built on vrc-get. It creates, backs up, migrates and duplicates projects and installs, upgrades and removes packages. It is not made or endorsed by VRChat.",
		"publisher": "zachLabs"
	}
}
